# Farcaster Authentication Configuration
# ================================

# Domain used for SIWE (Sign In With Ethereum) authentication
# Must match the actual domain where your app is hosted
# For production: addplaybutton.xyz
NEXT_PUBLIC_APP_DOMAIN=addplaybutton.xyz

# Full URL (with protocol) for SIWE authentication
# Must match the actual URL where your app is hosted
# For production: https://www.addplaybutton.xyz
NEXT_PUBLIC_APP_URL=https://www.addplaybutton.xyz

# Comma-separated list of allowed domains for authentication
# Include all domains where your app might be accessed (www, non-www, etc.)
NEXT_PUBLIC_ALLOWED_DOMAINS=addplaybutton.xyz,www.addplaybutton.xyz

# Force real Farcaster authentication even on localhost
# Set to "true" to use real auth, "false" to use mock auth on localhost
# Default behavior: real auth on production domains, mock auth on localhost
NEXT_PUBLIC_FORCE_REAL_AUTH=false

# Warpcast API Key - Required for creating casts
# Get your API key from https://warpcast.com/developers
WARPCAST_API_KEY=your_warpcast_api_key_here

# Authentication Timeout (in milliseconds)
# How long to wait for Farcaster auth to complete before timing out
# Default is 30000 (30 seconds)
NEXT_PUBLIC_AUTH_TIMEOUT=30000

# API Configuration
# ================================

# Base URL for API endpoints (optional, defaults to app URL)
NEXT_PUBLIC_API_BASE_URL=https://www.addplaybutton.xyz/api

# Development Configuration
# ================================

# Set to "true" to enable additional debug logging
NEXT_PUBLIC_DEBUG_MODE=false

# Set to "true" to show the debug panel in the UI
NEXT_PUBLIC_SHOW_DEBUG_PANEL=false
